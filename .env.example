# Aircraft Spotter Radar environment-variable template.
# Copy this file to .env.local in the repository root.
# This file is safe to commit because it contains variable names only.
# Never place a real credential in this file.

# Daily Spotlight Web source. Safe default: mock.
# Supported values: mock | flightaware
# A key alone never enables live mode.
SPOTLIGHT_DATA_SOURCE=mock

# Forward-looking live Web window in minutes (15-180). Default: 60.
SPOTLIGHT_WINDOW_MINUTES=60

# Server cache lifetime in seconds (60-3600). Default: 300.
# Cached reads do not call FlightAware or create audit directories.
SPOTLIGHT_CACHE_SECONDS=300

# Maximum result pages per FlightAware endpoint (1-5). Default: 1.
# One fresh generation queries arrivals once and departures once.
SPOTLIGHT_MAX_PAGES=1

# Persist movements.csv, scores.csv, and run.json only on fresh live
# cache generations. Default: false. No audit is written in mock mode.
SPOTLIGHT_WEB_AUDIT=false

# FlightAware AeroAPI. Required only when SPOTLIGHT_DATA_SOURCE=flightaware
# or when manually running one of the live CLI probes.
FLIGHTAWARE_AEROAPI_KEY=

# Reserved for future integrations; neither variable is currently used.
# DATABASE_URL=
# AVIATION_API_KEY=
